# ========================================================
# Cấu hình môi trường Production cho Backend trên VPS
# Sao chép file này thành .env trên VPS: cp .env.prod.example .env
# ========================================================

# 1. Database PostgreSQL từ Supabase (chọn Region Singapore)
# Lưu ý: Thêm ?sslmode=require vào cuối URL
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=your-supabase-password

# 2. CORS & Cookie (Cho phép Cloudflare Pages / Workers truy cập API)
CORS_ALLOWED_ORIGINS=https://*.workers.dev,https://*.pages.dev,http://localhost:4321
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# 3. Telegram Live Chat Bot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# 4. Cấu hình thanh toán VietQR chuyển khoản
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=THUY SHOP BOUTIQUE

# 5. Đăng nhập Google (ADR 0004) — để trống = tắt nút đăng nhập Google, API vẫn boot bình thường
# Tạo OAuth client (Web application) tại console.cloud.google.com → Credentials.
# Authorized redirect URI: https://api.thuyshop.store/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. SePay webhook — tự động xác nhận đơn VietQR khi khách chuyển khoản (PLAN.md §12)
# Tạo webhook tại sepay.vn (URL https://api.thuyshop.store/api/v1/webhooks/sepay,
# header Authorization: Bearer <token>) rồi điền token đó vào đây. Trống = tắt.
SEPAY_API_TOKEN=
