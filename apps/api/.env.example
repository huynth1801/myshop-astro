# Copy to .env (git-ignored) or export in your shell / IDE run config.
# Spring Boot does not auto-load .env files — these document the env var contract
# used by src/main/resources/application.yml.
DB_URL=jdbc:postgresql://localhost:5432/myshop
DB_USERNAME=tgm-mac007
DB_PASSWORD=
# >= 32 random chars; generate with: openssl rand -base64 32
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
# Product image uploads (ADR 0005) — admin uploads land here and are served
# from /api/v1/files/. Point at a persistent volume in staging/prod.
UPLOAD_DIR=./data/uploads
# VietQR payment configuration (ADR 0008)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=MYSHOP BOUTIQUE

# Mail SMTP configuration (Order confirmation emails)
# Set MAIL_ENABLED=true when real SMTP credentials are provided.
# For Gmail SMTP: host=smtp.gmail.com, port=587, auth=true, starttls=true, password=<Google App Password>
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=myshop <noreply@myshop.vn>

# Telegram Live Chat configuration (ADR 0009)
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN
# Get your numeric chat ID via @userinfobot to set TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SECRET_TOKEN=

