# Copy to .env (git-ignored).
# Server-side / build-time fetch (Astro frontmatter, getStaticPaths):
# 127.0.0.1 dodges a Node/undici localhost hang seen on this machine.
API_BASE_URL=http://127.0.0.1:8080
# Browser islands (cart coupon cookie) — MUST be same-site with the page origin
# (localhost:4321 ↔ localhost:8080), else SameSite=Lax blocks the cart cookie.
PUBLIC_API_URL=http://localhost:8080
