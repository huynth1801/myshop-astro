---
import Base from '../layouts/Base.astro';
import CheckoutForm from '../components/react/CheckoutForm';
import { Icon } from 'astro-icon/components';

export const prerender = false;
---

<Base title="Thanh toán" description="Hoàn tất đơn hàng và thanh toán nhanh chóng, an toàn tại Thuy Shop.">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-muted-foreground">
      <a href="/" class="hover:text-foreground">Trang chủ</a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span class="text-foreground">Thanh toán đơn hàng</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Thanh toán</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Vui lòng điền thông tin người nhận và lựa chọn phương thức thanh toán phù hợp.
      </p>
    </div>

    <CheckoutForm client:load />
  </div>
</Base>
