---
import Base from '../../../layouts/Base.astro';
import AdminProductEdit from '../../../components/react/AdminProductEdit';

const { id } = Astro.params;
---

<Base title="Sửa sản phẩm | Quản trị" description="Chỉnh sửa sản phẩm myshop">
  <section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <a
      href="/admin"
      class="text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
    >
      ← Danh sách sản phẩm
    </a>
    <div class="mt-4">
      {id ? <AdminProductEdit client:load id={id} /> : <p class="text-sm text-muted-foreground">Thiếu id sản phẩm.</p>}
    </div>
  </section>
</Base>
