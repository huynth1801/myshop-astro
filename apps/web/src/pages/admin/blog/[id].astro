---
import Base from '../../../layouts/Base.astro';
import AdminBlogEdit from '../../../components/react/AdminBlogEdit';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/blog');
}
---

<Base title="Soạn thảo bài viết | Quản trị myshop" description="Soạn thảo và tinh chỉnh bài viết blog cho myshop">
  <section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <AdminBlogEdit client:load postId={id} />
  </section>
</Base>
