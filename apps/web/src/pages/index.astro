---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/astro/ProductCard.astro';
import FilterBar from '../components/astro/FilterBar.astro';
import JsonLd from '../components/astro/JsonLd.astro';
import { getProducts } from '../lib/api/products';
import { getCategories } from '../lib/api/categories';

export const prerender = true;

const [categories, { content, totalElements }] = await Promise.all([
  getCategories(),
  getProducts(0, 60),
]);

if (content.length === 0) {
  // AGENTS.md: fail the build if the API has no products — never ship an empty catalog
  throw new Error('API returned 0 products — failing the build');
}
---

<Base
  title="Đồ dùng hàng ngày được chọn kỹ"
  description="Áo tee dày cay, hoodie fleeced, tất merino và phụ kiện bền — chọn ít, dùng lâu. Miễn phí giao hàng cho đơn từ 500K, đổi trả trong 30 ngày."
  canonical="/"
>
  <section id="collections" class="border-b border-border bg-canvas">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">Bộ sưu tập mới · 2026</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl text-foreground">
        Chọn ít.<br />Dùng lâu.
      </h1>
      <p class="mt-5 max-w-xl text-sm leading-relaxed text-foreground-secondary">
        Những món đồ hàng ngày được chọn kỹ — chất liệu tốt, làm tử tế, giá minh bạch.
        Không sale ảo, không rác thời trang.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#products"
          class="rounded-full bg-foreground px-7 py-3 text-xs font-semibold uppercase tracking-[0.08em] text-background transition hover:bg-neutral-800"
        >
          Khám phá — {totalElements} sản phẩm
        </a>
        <span class="text-xs text-foreground-muted">Freeship từ 500K · Đổi trả 30 ngày</span>
      </div>
    </div>
  </section>

  <FilterBar categories={categories} activeSlug="all" totalCount={totalElements} />

  <section id="products" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="text-xl font-medium tracking-tight text-foreground">Tất cả sản phẩm</h2>
      <p class="text-xs tabular-nums text-foreground-muted">{totalElements} món</p>
    </div>
    <ul class="mt-8 grid list-none grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 sm:gap-y-14 lg:grid-cols-4" role="list">
      {content.map((product, index) => (
        <li><ProductCard product={product} eager={index < 4} /></li>
      ))}
    </ul>
  </section>

  <!-- Triết lý thiết kế (Brand Philosophy) -->
  <section id="philosophy" class="border-t border-border bg-canvas py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">Triết lý thiết kế</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight text-foreground sm:text-4xl">
          Đồ dùng hàng ngày,<br />làm từ sự tỉ mỉ.
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="rounded-md border border-border bg-surface p-6 sm:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-foreground-muted">01 / Công năng</p>
          <h3 class="mt-3 text-base font-medium text-foreground">Tối giản công năng</h3>
          <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
            Không chi tiết thừa thãi. Mọi đường may, khóa kéo và ngăn chứa đều phục vụ nhu cầu chuyển động tự nhiên hàng ngày.
          </p>
        </div>

        <div class="rounded-md border border-border bg-surface p-6 sm:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-foreground-muted">02 / Bền bỉ</p>
          <h3 class="mt-3 text-base font-medium text-foreground">Chất liệu tuyển chọn</h3>
          <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
            Vải nylon trượt nước chịu lực, len merino tự nhiên thoáng khí, và phụ kiện kim loại đúc mờ không hoen gỉ.
          </p>
        </div>

        <div class="rounded-md border border-border bg-surface p-6 sm:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-foreground-muted">03 / Giá trị</p>
          <h3 class="mt-3 text-base font-medium text-foreground">Minh bạch trung thực</h3>
          <p class="mt-2 text-sm leading-relaxed text-foreground-secondary">
            Sản xuất trực tiếp từ xưởng đến tay người dùng. Không chi phí mặt bằng xa xỉ, không xả hàng ảo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cam kết chất lượng (Commitments) -->
  <section id="commitments" class="border-t border-border bg-background py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 divide-y divide-border border-y border-border md:grid-cols-3 md:divide-x md:divide-y-0">
        <div class="py-6 md:px-6">
          <p class="text-xs font-semibold uppercase tracking-[0.08em] text-foreground">Đổi trả trong 30 ngày</p>
          <p class="mt-1.5 text-xs leading-relaxed text-foreground-secondary">Thử đồ thoải mái tại nhà. Hỗ trợ đổi size hoặc hoàn tiền nhanh gọn.</p>
        </div>
        <div class="py-6 md:px-6">
          <p class="text-xs font-semibold uppercase tracking-[0.08em] text-foreground">Miễn phí giao hàng</p>
          <p class="mt-1.5 text-xs leading-relaxed text-foreground-secondary">Freeship toàn quốc cho đơn từ 500K. Đóng gói hộp giấy tái chế cao cấp.</p>
        </div>
        <div class="py-6 md:px-6">
          <p class="text-xs font-semibold uppercase tracking-[0.08em] text-foreground">Hỗ trợ trọn đời</p>
          <p class="mt-1.5 text-xs leading-relaxed text-foreground-secondary">Hỗ trợ bảo dưỡng khóa kéo và đường chỉ trọn đời cho mọi phụ kiện mang thương hiệu.</p>
        </div>
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'myshop',
      url: (Astro.site ?? new URL('https://myshop.example.com')).toString(),
    }}
  />
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'myshop',
      url: (Astro.site ?? new URL('https://myshop.example.com')).toString(),
      inLanguage: 'vi',
    }}
  />
</Base>
