---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/astro/ProductCard.astro';
import JsonLd from '../components/astro/JsonLd.astro';
import { getProducts } from '../lib/api/products';

export const prerender = true;

const { content, totalElements } = await getProducts(0, 60);
if (content.length === 0) {
  // AGENTS.md: fail the build if the API has no products — never ship an empty catalog
  throw new Error('API returned 0 products — failing the build');
}
---

<Base
  title="Đồ dùng hàng ngày được chọn kỹ"
  description="Áo tee dày cay, hoodie fleeced, tất merino và phụ kiện bền — chọn ít, dùng lâu. Miễn phí giao hàng cho đơn từ 500K, đổi trả trong 30 ngày."
  canonical="/"
>
  <section class="relative overflow-hidden border-b bg-muted">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Bộ sưu tập mới</p>
      <h1 class="mt-3 max-w-2xl text-4xl font-semibold sm:text-5xl">
        Chọn ít.<br />Dùng lâu.
      </h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        Những món đồ hàng ngày được chọn kỹ — chất liệu tốt, làm tử tế, giá minh bạch.
        Không sale ảo, không rác thời trang.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#products"
          class="rounded-full bg-primary px-7 py-3 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
        >
          Mua ngay — {totalElements} sản phẩm
        </a>
        <span class="text-sm text-muted-foreground">Freeship từ 500K · Đổi trả 30 ngày</span>
      </div>
    </div>
    <div
      class="pointer-events-none absolute -right-24 -top-24 size-96 rounded-full bg-accent/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
  </section>

  <section id="products" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-semibold">Tất cả sản phẩm</h2>
      <p class="text-sm text-muted-foreground">{totalElements} món</p>
    </div>
    <ul class="mt-8 grid list-none grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4" role="list">
      {content.map((product, index) => (
        <li><ProductCard product={product} eager={index < 4} /></li>
      ))}
    </ul>
  </section>

  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'myshop',
      url: (Astro.site ?? new URL('https://myshop.example.com')).toString(),
    }}
  />
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'myshop',
      url: (Astro.site ?? new URL('https://myshop.example.com')).toString(),
      inLanguage: 'vi',
    }}
  />
</Base>
