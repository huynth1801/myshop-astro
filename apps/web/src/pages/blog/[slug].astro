---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/astro/JsonLd.astro';
import ProductCard from '../../components/astro/ProductCard.astro';
import { getPost, type PostDetail } from '../../lib/api/blog';
import { resolveImageUrl } from '../../lib/api/urls';
import { Icon } from 'astro-icon/components';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

let post: PostDetail;
try {
  post = await getPost(slug);
} catch (err) {
  return new Response('Bài viết không tồn tại', { status: 404 });
}

const coverUrl = resolveImageUrl(post.featuredImage);
const canonicalUrl = Astro.url.pathname;
const metaTitle = post.seoTitle || `${post.title} | myshop Blog`;
const metaDescription = post.seoDescription || post.summary || post.title;

function formatDate(dateStr: string | null | undefined): string {
  if (!dateStr) return '';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return '';
  }
}

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: metaDescription,
  image: coverUrl ? new URL(coverUrl, siteOrigin).href : undefined,
  author: {
    '@type': 'Person',
    name: post.author || 'myshop Editorial',
  },
  datePublished: post.publishedAt || post.createdAt,
  dateModified: post.publishedAt || post.createdAt,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: Astro.url.href },
  ],
};
---

<Base
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogImage={coverUrl ?? undefined}
>
  <JsonLd schema={articleSchema} />
  <JsonLd schema={breadcrumbSchema} />

  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="Đường dẫn điều hướng" class="mb-8 flex items-center gap-2 text-xs text-muted-foreground">
      <a href="/" class="hover:text-foreground">Trang chủ</a>
      <Icon name="lucide:chevron-right" class="h-3 w-3" />
      <a href="/blog" class="hover:text-foreground">Blog</a>
      <Icon name="lucide:chevron-right" class="h-3 w-3" />
      <span class="line-clamp-1 max-w-[200px] text-foreground sm:max-w-none">{post.title}</span>
    </nav>

    <!-- Post Header -->
    <header class="mb-10 text-center sm:mb-12">
      <div class="flex items-center justify-center gap-3 text-xs text-muted-foreground">
        {post.publishedAt && (
          <time datetime={post.publishedAt} class="font-medium">
            {formatDate(post.publishedAt)}
          </time>
        )}
        {post.author && (
          <>
            <span class="inline-block h-1 w-1 rounded-full bg-border"></span>
            <span>Tác giả: <strong class="font-medium text-foreground">{post.author}</strong></span>
          </>
        )}
      </div>

      <h1 class="mt-4 text-2xl font-normal leading-tight tracking-tight text-foreground sm:text-3xl md:text-4xl">
        {post.title}
      </h1>

      {post.summary && (
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
          {post.summary}
        </p>
      )}
    </header>

    <!-- Featured Image -->
    {coverUrl && (
      <div class="mb-12 overflow-hidden rounded-2xl border border-border/80 bg-muted shadow-sm">
        <img
          src={coverUrl}
          alt={post.title}
          class="aspect-[16/9] w-full object-cover object-center"
          loading="eager"
        />
      </div>
    )}

    <!-- Main Content -->
    <div
      class="prose prose-neutral max-w-none text-base leading-relaxed text-foreground/90 sm:text-lg
        prose-headings:font-normal prose-headings:tracking-tight prose-headings:text-foreground
        prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-2xl
        prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl
        prose-p:my-4 prose-p:leading-relaxed
        prose-img:my-8 prose-img:rounded-xl prose-img:border prose-img:border-border prose-img:shadow-sm
        prose-a:text-accent prose-a:underline hover:prose-a:text-foreground
        prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:pl-4 prose-blockquote:italic
        prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6
        prose-ol:my-4 prose-ol:list-decimal prose-ol:pl-6"
      set:html={post.content}
    />

    <!-- Conversion Section: Related Products -->
    {post.relatedProducts.length > 0 && (
      <section class="mt-16 border-t border-border pt-12">
        <div class="mb-8 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Gợi ý trang phục</p>
            <h2 class="mt-1 text-xl font-medium tracking-tight text-foreground sm:text-2xl">
              Sản phẩm được nhắc đến trong bài viết
            </h2>
          </div>
          <a
            href="/#products"
            class="hidden text-xs font-medium uppercase tracking-wider text-muted-foreground hover:text-foreground sm:inline-flex items-center gap-1"
          >
            <span>Xem tất cả</span>
            <Icon name="lucide:arrow-right" class="h-3 w-3" />
          </a>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
          {post.relatedProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </section>
    )}

    <!-- Back to blog link -->
    <div class="mt-16 border-t border-border/60 pt-8 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-2.5 text-xs font-medium uppercase tracking-wider text-foreground transition hover:bg-muted"
      >
        <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />
        <span>Quay lại danh sách bài viết</span>
      </a>
    </div>
  </article>
</Base>
