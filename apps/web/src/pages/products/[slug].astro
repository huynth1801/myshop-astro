---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/astro/JsonLd.astro';
import ProductCard from '../../components/astro/ProductCard.astro';
import AddToCartButton from '../../components/react/AddToCartButton';
import ProductImageGallery from '../../components/react/ProductImageGallery';
import {
  getProduct,
  getRecommendations,
  type ProductDetail,
  type ProductSummary,
} from '../../lib/api/products';
import { resolveImageUrl } from '../../lib/api/urls';
import { formatCents, centsToDecimalString } from '../../lib/money';

// ADR 0011: catalog renders on demand so admin edits show up immediately.
export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/');
}

let product: ProductDetail;
let crossSells: ProductSummary[] = [];

try {
  const [productData, crossSellData] = await Promise.all([
    getProduct(slug),
    getRecommendations(slug, 'CROSS_SELL', 4).catch(() => [] as ProductSummary[]),
  ]);
  product = productData;
  crossSells = crossSellData;
} catch {
  return new Response('Sản phẩm không tồn tại', { status: 404 });
}
const primaryImage = product.images[0];
const prices = product.variants.map((v) => v.priceCents);
const minPrice = prices.length > 0 ? Math.min(...prices) : 0;
const maxPrice = prices.length > 0 ? Math.max(...prices) : 0;
const minCompareAt = Math.min(
  ...product.variants.map((v) => v.compareAtPriceCents ?? v.priceCents),
);
const hasCompare = minCompareAt > minPrice;
const availability = product.inStock
  ? 'https://schema.org/InStock'
  : 'https://schema.org/OutOfStock';
const variantOptions = product.variants.map((variant) => ({
  id: variant.id,
  label: Object.values(variant.attributes).join(', ') || variant.sku,
  sku: variant.sku,
  priceCents: variant.priceCents,
  compareAtPriceCents: variant.compareAtPriceCents ?? null,
  stock: variant.stock,
  attributes: variant.attributes,
}));

const galleryImages = product.images.map((img) => ({
  url: resolveImageUrl(img.url) || '',
  alt: img.alt,
  position: img.position,
}));
---

<Base
  title={product.name}
  description={(product.shortDescription ?? product.description).slice(0, 160)}
  canonical={`/products/${product.slug}/`}
  ogImage={resolveImageUrl(primaryImage?.url) ?? undefined}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:grid lg:grid-cols-2 lg:gap-12 lg:px-8">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <ProductImageGallery client:load images={galleryImages} productName={product.name} />
    </div>

    <div class="mt-8 lg:mt-0">
      <nav aria-label="Breadcrumb" class="text-[11px] font-semibold uppercase tracking-[0.14em] text-foreground-muted">
        <ol class="flex list-none gap-2">
          <li><a href="/" class="transition-colors hover:text-foreground">Trang chủ</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/categories/${product.category.slug}/`} class="transition-colors hover:text-foreground">
              {product.category.name}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-foreground">{product.name}</li>
        </ol>
      </nav>

      <h1 class="mt-4 text-3xl font-medium tracking-tight text-foreground sm:text-4xl text-pretty">{product.name}</h1>
      <p class="mt-3 text-xl font-semibold tabular-nums text-foreground">
        {minPrice !== maxPrice ? `${formatCents(minPrice)} – ${formatCents(maxPrice)}` : formatCents(minPrice)}
        {hasCompare && (
          <s class="ml-2 text-sm font-normal text-foreground-muted">{formatCents(minCompareAt)}</s>
        )}
      </p>
      {product.shortDescription && (
        <p class="mt-4 text-sm leading-relaxed text-foreground-secondary">{product.shortDescription}</p>
      )}

      {product.inStock && variantOptions.length > 0 ? (
        <div class="mt-6">
          <AddToCartButton client:load variants={variantOptions} />
        </div>
      ) : (
        <p class="mt-6 rounded-md border border-border bg-muted px-4 py-3 text-xs text-foreground-secondary">
          Tạm hết hàng — trang vẫn sống cho SEO, availability đã chuyển thành OutOfStock trong dữ
          liệu cấu trúc bên dưới.
        </p>
      )}

      <div class="mt-8 divide-y border-t border-border">
        <details open class="py-4">
          <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.08em] text-foreground">Mô tả sản phẩm</summary>
          <p class="mt-3 text-sm leading-relaxed text-foreground-secondary whitespace-pre-line">{product.description}</p>
        </details>
        <details class="py-4">
          <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.08em] text-foreground">Chất liệu & cách giặt</summary>
          <p class="mt-3 text-sm leading-relaxed text-foreground-secondary">
            Chất liệu và hướng dẫn giặt được ghi trên nhãn sản phẩm. Giặt lạnh, phơi bóng râm để
            giữ form và màu lâu nhất.
          </p>
        </details>
        <details class="py-4">
          <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.08em] text-foreground">Giao hàng & đổi trả</summary>
          <p class="mt-3 text-sm leading-relaxed text-foreground-secondary">
            Miễn phí giao hàng cho đơn từ 99K. Đổi trả trong 14 ngày nếu sản phẩm còn tag và chưa
            qua sử dụng.
          </p>
        </details>
      </div>
    </div>
  </div>

  {crossSells.length > 0 && (
    <section aria-label="Thường mua cùng" class="mx-auto max-w-7xl px-4 pb-16 pt-4 sm:px-6 lg:px-8">
      <div class="border-t border-border pt-10">
        <h2 class="text-xl font-medium tracking-tight text-foreground">Thường mua cùng</h2>
        <ul class="mt-8 grid list-none grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 sm:gap-y-14 lg:grid-cols-4" role="list">
          {crossSells.map((item) => (
            <li><ProductCard product={item} eager={false} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.shortDescription ?? product.description,
      image: product.images.map((image) => resolveImageUrl(image.url)),
      sku: product.variants[0]?.sku,
      offers: {
        '@type': 'Offer',
        price: centsToDecimalString(minPrice),
        priceCurrency: 'VND',
        availability,
        url: new URL(`/products/${product.slug}/`, Astro.site).toString(),
      },
    }}
  />
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: Astro.site?.toString() },
        {
          '@type': 'ListItem',
          position: 2,
          name: product.category.name,
          item: new URL(`/categories/${product.category.slug}/`, Astro.site).toString(),
        },
        { '@type': 'ListItem', position: 3, name: product.name },
      ],
    }}
  />
</Base>
