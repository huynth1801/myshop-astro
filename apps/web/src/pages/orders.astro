---
import Base from '../layouts/Base.astro';
import MyOrdersView from '../components/react/MyOrdersView';
import { Icon } from 'astro-icon/components';

export const prerender = false;
---

<Base title="Đơn mua của tôi" description="Quản lý và theo dõi lịch sử tất cả các đơn hàng đã đặt tại myshop.">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-muted-foreground print:hidden">
      <a href="/" class="hover:text-foreground">Trang chủ</a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span class="text-foreground">Đơn mua của tôi</span>
    </nav>

    <!-- Page Title Header -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Đơn mua của tôi</h1>
        <p class="mt-1 text-xs text-muted-foreground sm:text-sm">
          Tất cả đơn hàng của bạn được lưu tự động trên thiết bị này. Nhấn "Thanh toán ngay" để quét mã VietQR nếu chưa chuyển khoản.
        </p>
      </div>

      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground transition hover:bg-muted"
      >
        <span>Khám phá sản phẩm</span>
        <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>

    <MyOrdersView client:load />
  </div>
</Base>
