---
import Base from '../layouts/Base.astro';
import OrderSuccessView from '../components/react/OrderSuccessView';
import { Icon } from 'astro-icon/components';

export const prerender = false;

const code = Astro.url.searchParams.get('code') || '';
---

<Base title={`Đơn hàng ${code || ''}`} description="Thông tin chi tiết và thanh toán đơn hàng myshop.">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-muted-foreground print:hidden">
      <a href="/" class="hover:text-foreground">Trang chủ</a>
      <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
      <span class="text-foreground">Chi tiết đơn hàng</span>
    </nav>

    <OrderSuccessView initialCode={code} client:load />
  </div>
</Base>
