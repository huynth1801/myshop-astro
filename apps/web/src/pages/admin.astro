---
import Base from '../layouts/Base.astro';
import AdminDashboard from '../components/react/AdminDashboard';
---

<Base title="Quản trị" description="Quản trị myshop — dành cho ADMIN">
  <section class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Quản trị — Sản phẩm</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          Thêm / chỉnh sản phẩm, biến thể, giá và tồn kho. Thay đổi hiện ngay trên shop.
        </p>
      </div>
      <a
        href="/"
        class="rounded-full border border-border px-4 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        ← Về cửa hàng
      </a>
    </div>
    <AdminDashboard client:load />
  </section>
</Base>
