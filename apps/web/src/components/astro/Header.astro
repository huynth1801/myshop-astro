---
import CartWidget from '../react/CartWidget';
import AuthButton from '../react/AuthButton';
import { categoryDisplayName, getCategories } from '../../lib/api/categories';

const categories = await getCategories();
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <a href="/" class="text-sm font-semibold uppercase tracking-[0.18em] transition-opacity hover:opacity-75">
        myshop<span class="text-accent">.</span>
      </a>

      <nav aria-label="Danh mục" class="hidden items-center gap-1 text-xs font-medium uppercase tracking-[0.06em] md:flex">
        <a
          href="/"
          class="rounded-full px-3.5 py-1.5 text-foreground-secondary transition-colors hover:bg-muted hover:text-foreground"
        >
          Tất cả
        </a>
        {categories.map((category) => (
          <a
            href={`/categories/${category.slug}/`}
            class="rounded-full px-3.5 py-1.5 text-foreground-secondary transition-colors hover:bg-muted hover:text-foreground"
          >
            {categoryDisplayName(category)}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <AuthButton client:idle />
      <CartWidget client:load />
    </div>
  </div>

  <nav
    aria-label="Danh mục (mobile)"
    class="flex items-center gap-2 overflow-x-auto border-t border-border px-4 py-2.5 text-xs font-medium uppercase tracking-[0.05em] md:hidden"
  >
    <a href="/" class="shrink-0 rounded-full bg-muted px-3.5 py-1.5 text-foreground">Tất cả</a>
    {categories.map((category) => (
      <a
        href={`/categories/${category.slug}/`}
        class="shrink-0 rounded-full px-3.5 py-1.5 text-foreground-secondary hover:text-foreground"
      >
        {categoryDisplayName(category)}
      </a>
    ))}
  </nav>
</header>

