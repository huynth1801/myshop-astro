---
import CartWidget from '../react/CartWidget';
import AuthButton from '../react/AuthButton';
import OrdersNavButton from '../react/OrdersNavButton';
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-10">
      <a href="/" class="text-sm font-semibold uppercase tracking-[0.18em] transition-opacity hover:opacity-75">
        Thuy shop<span class="text-accent">.</span>
      </a>

      <!-- Brand & Lifestyle Navigation (No category duplication) -->
      <nav aria-label="Điều hướng chính" class="hidden items-center gap-6 text-xs font-medium uppercase tracking-[0.08em] md:flex">
        <a
          href="/#products"
          class="text-foreground-secondary transition-colors hover:text-foreground"
        >
          Sản phẩm
        </a>
        <a
          href="/orders"
          class="text-foreground-secondary transition-colors hover:text-foreground"
        >
          Đơn mua
        </a>
        <a
          href="/#collections"
          class="text-foreground-secondary transition-colors hover:text-foreground"
        >
          Bộ sưu tập
        </a>
        <a
          href="/blog"
          class="text-foreground-secondary transition-colors hover:text-foreground"
        >
          Blog
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <OrdersNavButton client:load />
      <AuthButton client:only="react" />
      <CartWidget client:load />
    </div>
  </div>

  <!-- Mobile Brand Navigation Bar -->
  <nav
    aria-label="Điều hướng (mobile)"
    class="flex items-center justify-around border-t border-border px-4 py-2.5 text-xs font-medium uppercase tracking-[0.06em] md:hidden"
  >
    <a href="/#products" class="text-foreground-secondary hover:text-foreground">Sản phẩm</a>
    <a href="/orders" class="text-foreground-secondary hover:text-foreground">Đơn mua</a>
    <a href="/#collections" class="text-foreground-secondary hover:text-foreground">Bộ sưu tập</a>
    <a href="/blog" class="text-foreground-secondary hover:text-foreground">Blog</a>
  </nav>
</header>

