---
import type { Category } from '../../lib/api/categories';
import { categoryDisplayName } from '../../lib/api/categories';

interface Props {
  categories: Category[];
  activeSlug?: string;
  totalCount?: number;
}

const { categories, activeSlug = 'all', totalCount } = Astro.props;
---

<nav aria-label="Bộ lọc danh mục" class="border-y border-border bg-background py-3">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5">
      <a
        href="/"
        class:list={[
          'shrink-0 rounded-full px-4 py-1.5 text-xs font-medium transition-colors',
          activeSlug === 'all'
            ? 'bg-foreground text-background font-semibold'
            : 'border border-border text-foreground-secondary hover:border-foreground hover:text-foreground',
        ]}
      >
        Tất cả
      </a>
      {categories.map((category) => {
        const isActive = activeSlug === category.slug;
        return (
          <a
            href={`/categories/${category.slug}/`}
            class:list={[
              'shrink-0 rounded-full px-4 py-1.5 text-xs font-medium transition-colors',
              isActive
                ? 'bg-foreground text-background font-semibold'
                : 'border border-border text-foreground-secondary hover:border-foreground hover:text-foreground',
            ]}
          >
            {categoryDisplayName(category)}
          </a>
        );
      })}
    </div>

    {totalCount !== undefined && (
      <span class="hidden shrink-0 text-xs tabular-nums text-foreground-muted sm:inline-block">
        {totalCount} sản phẩm
      </span>
    )}
  </div>
</nav>
