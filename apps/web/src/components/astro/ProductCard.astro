---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ProductSummary } from '../../lib/api/products';
import { resolveImageUrl } from '../../lib/api/urls';
import { formatCents } from '../../lib/money';

interface Props {
  product: ProductSummary;
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const primarySrc = resolveImageUrl(product.image?.url);
const hoverSrc = resolveImageUrl(product.hoverImage?.url);

const compareAt = product.compareAtFromCents ?? null;
const discount =
  compareAt != null && product.priceFromCents != null && compareAt > product.priceFromCents
    ? Math.round((1 - product.priceFromCents / compareAt) * 100)
    : 0;
const isNew = Date.now() - Date.parse(product.createdAt) < 14 * 24 * 3600 * 1000;
const quickAddVariant = product.inStock ? product.defaultVariantId : null;
---

<article class="group relative flex flex-col">
  <!-- 1. Studio Mat Cutout Container -->
  <div class="relative aspect-[4/5] w-full overflow-hidden rounded-md border border-border bg-muted">
    <a href={`/products/${product.slug}/`} aria-label={product.name} class="block h-full w-full">
      {primarySrc && product.image ? (
        <Image
          src={primarySrc}
          alt={product.image.alt}
          width={600}
          height={750}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          class:list={[
            'h-full w-full object-cover object-center transition duration-300 ease-out',
            hoverSrc ? 'group-hover:opacity-0' : 'group-hover:scale-[1.02]',
          ]}
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-xs text-foreground-muted">
          Chưa có hình ảnh
        </div>
      )}
      {hoverSrc && (
        <Image
          src={hoverSrc}
          alt=""
          aria-hidden="true"
          width={600}
          height={750}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-center opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100"
        />
      )}
    </a>

    <!-- Flat Solid Badges (Top Left) -->
    <div class="pointer-events-none absolute left-3 top-3 z-10 flex flex-col items-start gap-1.5">
      {!product.inStock ? (
        <span class="rounded-full bg-border px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-foreground-secondary">
          Hết hàng
        </span>
      ) : isNew ? (
        <span class="rounded-full bg-foreground px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-background">
          Mới ra mắt
        </span>
      ) : null}
      {discount > 0 && product.inStock && (
        <span class="rounded-full bg-accent-terracotta px-2.5 py-0.5 text-[10px] font-semibold tracking-wide text-white">
          −{discount}%
        </span>
      )}
    </div>

    <!-- Quick Add Slide-Up Pill Button -->
    {quickAddVariant && (
      <div class="absolute inset-x-3 bottom-3 z-20 hidden justify-center md:flex">
        <button
          type="button"
          data-quick-add={quickAddVariant}
          data-product-title={product.name}
          class="inline-flex h-9 items-center justify-center gap-1.5 rounded-full bg-foreground px-5 text-[11px] font-semibold uppercase tracking-[0.08em] text-background transition-all duration-200 ease-out translate-y-2 opacity-0 hover:bg-neutral-800 active:scale-95 group-hover:translate-y-0 group-hover:opacity-100"
        >
          <span>Thêm nhanh</span>
          <Icon name="lucide:plus" class="h-3.5 w-3.5" />
        </button>
      </div>
    )}
  </div>

  <!-- 2. Product Metadata & Price Block -->
  <div class="mt-3 flex flex-col gap-1 px-0.5">
    <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-foreground-muted">
      {product.category.name}
    </p>
    <h3 class="text-sm font-medium leading-snug text-foreground line-clamp-2">
      <a href={`/products/${product.slug}/`} class="transition-colors hover:text-foreground-secondary">
        {product.name}
      </a>
    </h3>
    <div class="mt-0.5 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      {product.priceFromCents != null ? (
        <>
          <span class="text-sm font-semibold tabular-nums tracking-tight text-foreground">
            {formatCents(product.priceFromCents)}
          </span>
          {compareAt != null && compareAt > product.priceFromCents && (
            <span class="text-xs tabular-nums text-foreground-muted line-through">
              {formatCents(compareAt)}
            </span>
          )}
        </>
      ) : (
        <span class="text-xs text-foreground-muted">Ngừng bán</span>
      )}
    </div>
  </div>
</article>
