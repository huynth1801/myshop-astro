---
import { Image } from 'astro:assets';
import type { ProductSummary } from '../../lib/api/products';
import { formatCents } from '../../lib/money';

interface Props {
  product: ProductSummary;
}

const { product } = Astro.props;
const priceLabel =
  product.priceFromCents != null ? `from ${formatCents(product.priceFromCents)}` : null;
---

<article class="group">
  <a href={`/products/${product.slug}/`} class="block">
    <div class="aspect-square overflow-hidden rounded-lg border border-neutral-200 bg-neutral-50">
      {product.image ? (
        <Image
          src={product.image.url}
          alt={product.image.alt}
          width={800}
          height={800}
          loading="lazy"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-sm text-neutral-400">
          No image
        </div>
      )}
    </div>
    <div class="mt-3 space-y-1">
      <p class="text-xs uppercase tracking-wide text-neutral-500">{product.category.name}</p>
      <h2 class="font-medium">{product.name}</h2>
      {priceLabel ? (
        <p class="text-sm text-neutral-900">{priceLabel}</p>
      ) : (
        <p class="text-sm text-neutral-400">Unavailable</p>
      )}
    </div>
  </a>
</article>
