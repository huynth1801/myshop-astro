---
import Base from '../../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 md:py-14 lg:px-8">
    <nav
      aria-label="Đường dẫn điều hướng"
      class="mb-8 flex items-center gap-2 text-xs text-muted-foreground"
    >
      <a href="/" class="transition hover:text-foreground">Trang chủ</a>
      <span aria-hidden="true">/</span>
      <span class="font-medium text-foreground">{title}</span>
    </nav>

    <header class="mb-10">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent-olive/30 bg-accent-olive/10 px-3.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-accent-olive"
      >
        Chính sách
      </div>
      <h1 class="text-2xl font-light leading-snug tracking-tight text-foreground text-pretty sm:text-3xl">
        {title}
      </h1>
      {updated && <p class="mt-3 text-xs text-muted-foreground">Cập nhật lần cuối: {updated}</p>}
    </header>

    <div
      class="space-y-8 text-sm leading-relaxed text-muted-foreground [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mb-2 [&_h2]:text-base [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_li]:pl-0.5 [&_strong]:font-medium [&_strong]:text-foreground [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5"
    >
      <slot />
    </div>
  </article>
</Base>
